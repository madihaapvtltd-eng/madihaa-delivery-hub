rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - read/write for all (passcode-based auth)
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Shops collection - read/write for all (passcode-based auth)
    match /shops/{shopId} {
      allow read, write: if true;
    }
    
    // Vehicles collection - read/write for all (passcode-based auth)
    match /vehicles/{vehicleId} {
      allow read, write: if true;
    }
    
    // Drivers collection - read/write for all (passcode-based auth)
    match /drivers/{driverId} {
      allow read, write: if true;
    }
    
    // Staff collection - read/write for all (passcode-based auth)
    match /staff/{staffId} {
      allow read, write: if true;
    }
    
    // Boats collection - read/write for all (passcode-based auth)
    match /boats/{boatId} {
      allow read, write: if true;
    }
    
    // Islands collection - read/write for all (passcode-based auth)
    match /islands/{islandId} {
      allow read, write: if true;
    }
    
    // Deliveries - read/write for all (passcode-based auth)
    match /deliveries/{deliveryId} {
      allow read, write: if true;
    }
    
    // Delivery Trips - read/write for all (passcode-based auth)
    match /trips/{tripId} {
      allow read, write: if true;
    }

    match /deliveryTrips/{tripId} {
      allow read, write: if true;
    }
    
    // Boat Departure Batches - read/write for all (passcode-based auth)
    match /boatDepartureBatches/{batchId} {
      allow read, write: if true;
    }
    
    // Delivery Events - audit log
    match /deliveryEvents/{eventId} {
      allow read, write: if true;
    }
    
    // Attachments - read/write for all (passcode-based auth)
    match /attachments/{attachmentId} {
      allow read, write: if true;
    }

    // Delivery History - read/write for all (passcode-based auth)
    match /deliveryHistory/{historyId} {
      allow read, write: if true;
    }

    // Audit Logs - read/write for all (passcode-based auth)
    match /auditLogs/{logId} {
      allow read, write: if true;
    }
  }
}
